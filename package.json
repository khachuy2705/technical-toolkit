    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
