---
import { SITE } from "../data/site";
import { CHROME, type Lang } from "../data/i18n";

interface Props {
  lang?: Lang;
}

const text = CHROME[Astro.props.lang ?? "en"];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <span>&copy; {year} {SITE.name}</span>
    <span>{text.footerNote}</span>
    <span class="site-footer__spacer"></span>
    <a href="/about/">{text.about}</a>
    <a href="/privacy/">{text.privacy}</a>
  </div>
</footer>
