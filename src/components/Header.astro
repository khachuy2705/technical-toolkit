---
import { LIVE_TOOLS, toolHref, toolText } from "../data/tools";
import { CHROME, type Lang } from "../data/i18n";
import { SITE } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? "en";
const text = CHROME[lang];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path === href.replace(/\/$/, "");
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z"
        ></path>
      </svg>
      {SITE.name}
    </a>

    <nav class="site-nav" aria-label={text.mainNav}>
      {
        LIVE_TOOLS.map((tool) => (
          <a
            class="nav-tool"
            href={toolHref(tool)}
            aria-current={isCurrent(toolHref(tool)) ? "page" : undefined}
          >
            {lang === "en" ? tool.name.replace(" Generator", "") : toolText(tool, lang).name}
          </a>
        ))
      }
      <a href="/about/" aria-current={isCurrent("/about/") ? "page" : undefined}>{text.about}</a>
      <ThemeToggle lang={lang} />
    </nav>
  </div>
</header>
