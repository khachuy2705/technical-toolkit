---
import { TOOL_GROUPS } from "../data/tools";
import { CHROME, langAttr, type PageLang } from "../data/i18n";
import { SITE } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";
import Say from "./Say.astro";

interface Props {
  lang?: PageLang;
}

const lang = Astro.props.lang ?? "en";
const both = lang === "both";
const text = CHROME[both ? "en" : lang];
const path = Astro.url.pathname;
// Tools are listed by group on the home page; the header links to each group
// rather than to thirteen tools that would not fit on one line.
const isCurrent = (href: string) => path === href || path === href.replace(/\/$/, "");
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z"
        ></path>
      </svg>
      {SITE.name}
    </a>

    <nav class="site-nav" {...langAttr(lang, "aria-label", CHROME.en.mainNav, CHROME.vi.mainNav)}>
      {
        TOOL_GROUPS.map((group) => (
          <a class="nav-tool" href={`/#${group.id}`}>
            {both ? <Say en={group.name} vi={group.vi} /> : lang === "vi" ? group.vi : group.name}
          </a>
        ))
      }
      <a href="/about/" aria-current={isCurrent("/about/") ? "page" : undefined}>
        {both ? <Say en={CHROME.en.about} vi={CHROME.vi.about} /> : text.about}
      </a>
      <ThemeToggle lang={lang} />
    </nav>
  </div>
</header>
