---
/**
 * Renders the inner markup of a 24x24 stroked icon. `set:html` is safe here:
 * every path comes from our own registry, never from user input.
 */
interface Props {
  paths: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { paths, size = 24, strokeWidth = 1.6, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={paths}
/>
