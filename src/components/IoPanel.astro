---
import Icon from "./Icon.astro";
import { ICONS } from "../data/icons";

/**
 * Input and output panes for the text-transform tools. The wiring lives in
 * lib/textio.ts; this file only lays out the controls it expects to find.
 */
interface Props {
  inputLabel?: string;
  outputLabel?: string;
  placeholder?: string;
  /** Shows the "Use as input" button, for tools whose output can be fed back. */
  swappable?: boolean;
}

const {
  inputLabel = "Input",
  outputLabel = "Output",
  placeholder = "Paste or type here…",
  swappable = false,
} = Astro.props;
---

<section class="io">
  <div class="io__pane">
    <div class="io__head">
      <label class="io__label" for="io-input">{inputLabel}</label>
      <span class="io__meta" id="input-meta"></span>
      <button type="button" class="btn btn--tiny" id="io-sample" hidden>Sample</button>
      <button type="button" class="btn btn--tiny" id="io-clear">Clear</button>
    </div>
    <textarea
      id="io-input"
      class="io__text"
      placeholder={placeholder}
      spellcheck="false"
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"></textarea>
  </div>

  <div class="io__pane">
    <div class="io__head">
      <label class="io__label" for="io-output">{outputLabel}</label>
      <span class="io__meta" id="output-meta"></span>
      {
        swappable && (
          <button type="button" class="btn btn--tiny" id="io-swap" title="Move the output up into the input">
            Use as input
          </button>
        )
      }
      <button type="button" class="btn btn--tiny" id="io-download">
        <Icon paths={ICONS.download} size={13} strokeWidth={1.9} />
        <span data-label>Save</span>
      </button>
      <button type="button" class="btn btn--tiny" id="io-copy">
        <Icon paths={ICONS.copy} size={13} strokeWidth={1.9} />
        <span data-label>Copy</span>
      </button>
    </div>
    <textarea id="io-output" class="io__text" readonly spellcheck="false"></textarea>
  </div>
</section>

<p class="output__error io__error" id="io-error" role="alert" hidden></p>
