---
import Icon from "./Icon.astro";
import Say from "./Say.astro";
import { toolHref, toolText, type Tool } from "../data/tools";
import { CHROME, type PageLang } from "../data/i18n";

interface Props {
  tool: Tool;
  lang?: PageLang;
}

const { tool, lang = "en" } = Astro.props;
const both = lang === "both";
const text = toolText(tool, both ? "en" : lang);
const vi = toolText(tool, "vi");
const planned = tool.status === "planned";
const Tag = planned ? "div" : "a";
---

<li>
  <Tag
    class:list={["tool-card", planned && "tool-card--planned"]}
    href={planned ? undefined : toolHref(tool)}
  >
    <Icon paths={tool.icon} size={22} class="tool-card__icon" />
    <span class="tool-card__name">{both ? <Say en={text.name} vi={vi.name} /> : text.name}</span>
    <span class="tool-card__tagline">{both ? <Say en={text.tagline} vi={vi.tagline} /> : text.tagline}</span>
    {
      planned && (
        <span class="badge">{both ? <Say en={CHROME.en.planned} vi={CHROME.vi.planned} /> : CHROME[lang].planned}</span>
      )
    }
  </Tag>
</li>
