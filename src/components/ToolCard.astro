---
import Icon from "./Icon.astro";
import { toolHref, type Tool } from "../data/tools";

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const planned = tool.status === "planned";
const Tag = planned ? "div" : "a";
---

<li>
  <Tag
    class:list={["tool-card", planned && "tool-card--planned"]}
    href={planned ? undefined : toolHref(tool)}
  >
    <Icon paths={tool.icon} size={22} class="tool-card__icon" />
    <span class="tool-card__name">{tool.name}</span>
    <span class="tool-card__tagline">{tool.tagline}</span>
    {planned && <span class="badge">Planned</span>}
  </Tag>
</li>
