---
import Icon from "./Icon.astro";
import { toolHref, toolText, type Tool } from "../data/tools";
import { CHROME, type Lang } from "../data/i18n";

interface Props {
  tool: Tool;
  lang?: Lang;
}

const { tool, lang = "en" } = Astro.props;
const text = toolText(tool, lang);
const planned = tool.status === "planned";
const Tag = planned ? "div" : "a";
---

<li>
  <Tag
    class:list={["tool-card", planned && "tool-card--planned"]}
    href={planned ? undefined : toolHref(tool)}
  >
    <Icon paths={tool.icon} size={22} class="tool-card__icon" />
    <span class="tool-card__name">{text.name}</span>
    <span class="tool-card__tagline">{text.tagline}</span>
    {planned && <span class="badge">{CHROME[lang].planned}</span>}
  </Tag>
</li>
