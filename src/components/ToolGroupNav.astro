---
/**
 * The sibling strip at the top of a tool page: every live tool in the same
 * group, the current one marked. Generated from the registry, so a new tool in
 * a group appears on all its siblings' pages without touching them.
 */
import Say from "./Say.astro";
import { groupById, liveToolsIn, toolBySlug, toolHref, toolText } from "../data/tools";
import { langAttr, type PageLang } from "../data/i18n";

interface Props {
  slug: string;
  lang?: PageLang;
}

const { slug, lang = "en" } = Astro.props;
const both = lang === "both";
const tool = toolBySlug(slug);
const group = groupById(tool.group);
const siblings = liveToolsIn(tool.group);
const nameEn = (sibling: (typeof siblings)[number]) => toolText(sibling, "en").name;
const nameVi = (sibling: (typeof siblings)[number]) => toolText(sibling, "vi").name;
---

{
  siblings.length > 1 && (
    <nav class="group-nav" {...langAttr(lang, "aria-label", `${group.name} tools`, `Công cụ nhóm ${group.vi}`)}>
      <a class="group-nav__label" href={`/#${group.id}`}>
        {both ? <Say en={group.name} vi={group.vi} /> : lang === "vi" ? group.vi : group.name}
      </a>
      <ul class="group-nav__list">
        {siblings.map((sibling) => (
          <li>
            <a href={toolHref(sibling)} aria-current={sibling.slug === slug ? "page" : undefined}>
              {both ? <Say en={nameEn(sibling)} vi={nameVi(sibling)} /> : lang === "vi" ? nameVi(sibling) : nameEn(sibling)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
