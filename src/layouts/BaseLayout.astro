---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site";
import { CHROME, type PageLang } from "../data/i18n";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Leave unset on the home page, where the title is already the site name. */
  suffix?: boolean;
  keywords?: readonly string[];
  /** Language of the page and of the chrome drawn around it. */
  lang?: PageLang;
  /** The Vietnamese title, for a page in both languages. */
  titleVi?: string;
}

const { title, description, suffix = true, keywords = [], lang = "en", titleVi } = Astro.props;

const full = (name: string) => (suffix ? `${name} — ${SITE.name}` : name);
const fullTitle = full(title);
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const bilingual = lang === "both";
---

<!doctype html>
<html
  lang={CHROME[bilingual ? "en" : lang].htmlLang}
  data-title-en={bilingual ? fullTitle : undefined}
  data-title-vi={bilingual ? full(titleVi ?? title) : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    {/* Runs before first paint so a dark-theme visitor never sees a white flash. */}
    <script is:inline>
      try {
        var t = localStorage.getItem("tt-theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>

    {
      /*
       * A page in both languages picks one before first paint, for the same
       * reason: ?lang= in the address, then the reader's last choice, then
       * the browser's language. Without script the page reads in English.
       */
      bilingual && (
        <script is:inline>
          (function () {
            var lang = "en";
            try {
              var asked = /[?&]lang=(en|vi)(?:&|$)/.exec(location.search);
              var kept = localStorage.getItem("tt-lang");
              if (asked) lang = asked[1];
              else if (kept === "en" || kept === "vi") lang = kept;
              else if (/^vi\b/i.test(navigator.language || "")) lang = "vi";
            } catch (e) {}
            var root = document.documentElement;
            root.setAttribute("data-lang", lang);
            root.lang = lang;
            var title = root.getAttribute("data-title-" + lang);
            if (title) document.title = title;
          })();
        </script>
      )
    }
  </head>

  <body>
    <Header lang={lang} />
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer lang={lang} />
  </body>
</html>
