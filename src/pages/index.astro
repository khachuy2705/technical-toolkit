---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCard from "../components/ToolCard.astro";
import { LIVE_TOOLS, PLANNED_TOOLS } from "../data/tools";
import { SITE } from "../data/site";
---

<BaseLayout title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description} suffix={false}>
  <section class="hero">
    <h1>Small tools that stay on your machine.</h1>
    <p>Everything runs in your browser. No accounts, no tracking, nothing sent anywhere.</p>
  </section>

  <ul class="tool-grid tool-grid--primary">
    {LIVE_TOOLS.map((tool) => <ToolCard tool={tool} />)}
  </ul>

  {
    PLANNED_TOOLS.length > 0 && (
      <section class="upcoming">
        <h2 class="section-label">On the way</h2>
        <ul class="tool-grid tool-grid--secondary">
          {PLANNED_TOOLS.map((tool) => (
            <ToolCard tool={tool} />
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
