---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCard from "../components/ToolCard.astro";
import { liveToolsIn, PLANNED_TOOLS, TOOL_GROUPS } from "../data/tools";
import { SITE } from "../data/site";
---

<BaseLayout title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description} suffix={false}>
  <section class="hero">
    <h1>Small tools that stay on your machine.</h1>
    <p>Everything runs in your browser. No accounts, no tracking, nothing sent anywhere.</p>
  </section>

  {
    TOOL_GROUPS.map((group) => {
      const tools = liveToolsIn(group.id);
      return (
        tools.length > 0 && (
          <section class="tool-section" id={group.id} aria-labelledby={`${group.id}-title`}>
            <h2 class="section-label" id={`${group.id}-title`}>
              {group.name}
            </h2>
            <ul class="tool-grid tool-grid--primary">
              {tools.map((tool) => (
                <ToolCard tool={tool} />
              ))}
            </ul>
          </section>
        )
      );
    })
  }

  {
    PLANNED_TOOLS.length > 0 && (
      <section class="upcoming">
        <h2 class="section-label">On the way</h2>
        <ul class="tool-grid tool-grid--secondary">
          {PLANNED_TOOLS.map((tool) => (
            <ToolCard tool={tool} />
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
