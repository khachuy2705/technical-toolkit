---
import ToolLayout from "../../layouts/ToolLayout.astro";
import OutputPanel from "../../components/OutputPanel.astro";
import BulkPanel from "../../components/BulkPanel.astro";
import RangeField from "../../components/RangeField.astro";
import { CHAR_CLASSES, AMBIGUOUS_CHARS } from "../../lib/charsets";
import {
  PASSWORD_LENGTH_MAX,
  PASSWORD_LENGTH_MIN,
  PASSWORD_LENGTH_DEFAULT,
  DEFAULT_PASSWORD_OPTIONS,
} from "../../lib/password";
---

<ToolLayout slug="password-generator">
  <OutputPanel placeholder="Generating…" generateLabel="Regenerate" />

  <section class="card">
    <h2 class="card__title">Options</h2>

    <div class="controls">
      <RangeField
        id="length"
        label="Length"
        min={PASSWORD_LENGTH_MIN}
        max={PASSWORD_LENGTH_MAX}
        value={PASSWORD_LENGTH_DEFAULT}
      >
        <p class="field__hint" id="pool-hint">Pool: 0 characters</p>
      </RangeField>

      <fieldset class="field" style="border:0;margin:0;padding:0;min-inline-size:0">
        <legend class="field__label" style="padding:0">Character types</legend>
        <div class="field__group">
          {
            CHAR_CLASSES.map((cls) => (
              <label class="check">
                <input
                  type="checkbox"
                  id={`class-${cls.id}`}
                  data-class={cls.id}
                  checked={DEFAULT_PASSWORD_OPTIONS.classes.includes(cls.id)}
                />
                <span class="check__text">
                  {cls.label}
                  <span class="check__sample">{cls.sample}</span>
                </span>
              </label>
            ))
          }
        </div>
        <p class="field__hint">All four are on by default — the strongest setting.</p>
      </fieldset>

      <fieldset class="field" style="border:0;margin:0;padding:0;min-inline-size:0">
        <legend class="field__label" style="padding:0">Rules</legend>
        <div class="field__group">
          <label class="check">
            <input type="checkbox" id="require-each" checked />
            <span class="check__text">
              At least one of each type
              <span class="check__sample">avoids all-lowercase results</span>
            </span>
          </label>
          <label class="check">
            <input type="checkbox" id="exclude-ambiguous" />
            <span class="check__text">
              Exclude ambiguous glyphs
              <span class="check__sample">{AMBIGUOUS_CHARS}</span>
            </span>
          </label>
          <label class="check">
            <input type="checkbox" id="no-repeats" />
            <span class="check__text">
              No repeated characters
              <span class="check__sample">caps length at the pool size</span>
            </span>
          </label>
        </div>
      </fieldset>
    </div>
  </section>

  <BulkPanel filename="passwords.txt" />

  <section class="card prose">
    <h2>How long should a password be?</h2>
    <p>
      Length beats complexity. Adding one character to a 90-symbol alphabet buys about 6.5 bits;
      switching from lowercase to mixed case buys one bit per character. Twenty random characters
      is comfortably past what any offline attack can reach today.
    </p>
    <p>
      The entropy figure above describes this generator, not the text it produced. It is the size
      of the space an attacker has to search assuming they know every setting on this page —
      which is the honest assumption.
    </p>

    <h2>Two caveats worth knowing</h2>
    <ul>
      <li>
        <b>At least one of each type</b> slightly narrows the space compared with a free draw, so
        the reported bits are a small over-estimate. The difference is under a bit at these
        lengths, and many sites reject passwords without it.
      </li>
      <li>
        <b>No repeated characters</b> is a real reduction in entropy, not an improvement. It exists
        because some legacy systems demand it. Leave it off unless you have to.
      </li>
    </ul>

    <h2>Where the randomness comes from</h2>
    <p>
      Every character is drawn from <code>crypto.getRandomValues()</code>, the browser&rsquo;s CSPRNG,
      using rejection sampling so no character is even slightly more likely than another. Nothing is
      generated on a server, and nothing you see here is transmitted or logged.
    </p>
  </section>
</ToolLayout>

<script>
  import { CHAR_CLASSES, type CharClassId } from "../../lib/charsets";
  import {
    buildPool,
    generatePassword,
    generatePasswords,
    validatePasswordOptions,
    type PasswordOptions,
  } from "../../lib/password";
  import { passwordEntropy } from "../../lib/entropy";
  import {
    all,
    attachBulk,
    attachCopy,
    bindStepper,
    el,
    loadPrefs,
    renderStrength,
    savePrefs,
  } from "../../lib/ui";
  import { ICONS } from "../../data/icons";

  const PREFS_KEY = "tt-password";

  const poolHint = el<HTMLElement>("#pool-hint");
  const result = el<HTMLOutputElement>("#result");
  const errorBox = el<HTMLParagraphElement>("#result-error");
  const strength = el<HTMLElement>("#strength");

  const classBoxes = all<HTMLInputElement>("[data-class]");
  const requireEach = el<HTMLInputElement>("#require-each");
  const excludeAmbiguous = el<HTMLInputElement>("#exclude-ambiguous");
  const noRepeats = el<HTMLInputElement>("#no-repeats");

  const length = bindStepper("length", update);

  type Prefs = {
    length: number;
    classes: CharClassId[];
    requireEachClass: boolean;
    excludeAmbiguous: boolean;
    noRepeats: boolean;
  };

  const DEFAULTS: Prefs = {
    length: length.value(),
    classes: CHAR_CLASSES.map((c) => c.id),
    requireEachClass: true,
    excludeAmbiguous: false,
    noRepeats: false,
  };

  function restore(): void {
    const prefs = loadPrefs(PREFS_KEY, DEFAULTS);

    // An empty stored class list would leave the generator with nothing to draw
    // from and the page showing only an error on arrival.
    const classes =
      Array.isArray(prefs.classes) && prefs.classes.length > 0 ? prefs.classes : DEFAULTS.classes;

    length.set(Number(prefs.length) || DEFAULTS.length);
    for (const box of classBoxes) {
      box.checked = classes.includes(box.dataset["class"] as CharClassId);
    }
    requireEach.checked = Boolean(prefs.requireEachClass);
    excludeAmbiguous.checked = Boolean(prefs.excludeAmbiguous);
    noRepeats.checked = Boolean(prefs.noRepeats);
  }

  function readOptions(): PasswordOptions {
    return {
      length: length.value(),
      classes: classBoxes.filter((b) => b.checked).map((b) => b.dataset["class"] as CharClassId),
      requireEachClass: requireEach.checked,
      excludeAmbiguous: excludeAmbiguous.checked,
      noRepeats: noRepeats.checked,
    };
  }

  /** Regenerates the headline result and repaints everything derived from the options. */
  function update(): void {
    const options = readOptions();

    const pool = buildPool(options);
    poolHint.textContent = `Pool: ${pool.length} character${pool.length === 1 ? "" : "s"}`;

    savePrefs(PREFS_KEY, {
      length: options.length,
      classes: options.classes,
      requireEachClass: options.requireEachClass,
      excludeAmbiguous: options.excludeAmbiguous,
      noRepeats: options.noRepeats,
    });

    const problem = validatePasswordOptions(options);
    if (problem) {
      errorBox.textContent = problem;
      errorBox.hidden = false;
      result.textContent = "—";
      result.dataset["empty"] = "true";
      renderStrength(strength, 0);
      return;
    }

    errorBox.hidden = true;
    result.textContent = generatePassword(options);
    delete result.dataset["empty"];
    renderStrength(strength, passwordEntropy(pool.length, options.length));
  }

  restore();
  update();

  for (const input of [...classBoxes, requireEach, excludeAmbiguous, noRepeats]) {
    input.addEventListener("change", update);
  }
  el<HTMLButtonElement>("#regenerate").addEventListener("click", update);
  attachCopy(el<HTMLButtonElement>("#copy"), () =>
    result.dataset["empty"] ? "" : (result.textContent ?? ""),
  );

  attachBulk({
    generate: (count) => generatePasswords(readOptions(), count),
    filename: "passwords.txt",
    copyIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS.copy}</svg>`,
  });
</script>
